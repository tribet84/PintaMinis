rules_version = '2';

// Private data lives under users/{userId}; a signed-in user can only touch
// their own subtree. Shared recipes live in the top-level publishedRecipes
// collection: readable by any signed-in user, writable only by their owner.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // Platform admins may READ across all users for the in-app admin panel
    // (Firestore count() aggregations — see the collection-group matches at
    // the bottom). Admin is an Auth CUSTOM CLAIM, granted server-side only
    // (Admin API), so no admin identity lives in this repository and no
    // client can grant it to itself — user docs are client-writable, which
    // is exactly why this must NOT be a Firestore field.
    function isPlatformAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // The user doc itself holds one-shot flags (e.g. sample recipe seeded).
      allow read, write: if isOwner();
      // Admin panel: counting users needs list permission on the collection.
      allow read: if isPlatformAdmin();

      // Paint status: users/{userId}/inventory/{paintId}
      match /inventory/{paintId} {
        allow read, write: if isOwner();
      }

      // Custom paint lists: users/{userId}/paintLists/{listId}
      match /paintLists/{listId} {
        allow read, write: if isOwner();
      }

      // Painting recipes: users/{userId}/recipes/{recipeId}
      match /recipes/{recipeId} {
        allow read, write: if isOwner();
      }

      // Links to other painters' published recipes.
      match /linkedRecipes/{publishedId} {
        allow read, write: if isOwner();
      }

      // Authors this user follows, with the watermark of what they have
      // already seen. Private: who you follow is nobody else's business.
      match /following/{authorUid} {
        allow read, write: if isOwner();
      }
    }

    // One marker per follower of an author, keyed by the follower's uid —
    // the same shape that keeps recipe link counts honest: the count is
    // computable by anyone signed in, but each account holds exactly one
    // vote and only over its own marker. The author cannot purge followers:
    // unlike recipe links, a follow belongs to the follower alone.
    match /follows/{authorUid}/followers/{followerUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == followerUid;
      // The follower owns the follow — but the AUTHOR may also delete
      // markers pointing at them, for the same reason recipe owners may
      // delete link markers: account deletion has to sweep its own
      // followers subtree, and a follower's marker outliving the followed
      // account would be a ghost nobody could ever remove.
      allow delete: if request.auth != null
        && (request.auth.uid == followerUid
            || request.auth.uid == authorUid);
    }

    // Public copies of shared recipes. Anyone signed in can read; only the
    // owner can create, update or remove them, and ownership can never be
    // reassigned.
    match /publishedRecipes/{publishedId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // One marker doc per painter who linked this recipe, keyed by their
      // uid, so the link count is computable without server code and nobody
      // can inflate it beyond their single vote. The recipe owner can also
      // delete markers here — needed to clean up on unpublish and on account
      // deletion, since a marker's linker is not the recipe's owner.
      match /links/{linkerUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == linkerUid;
        allow delete: if request.auth != null
          && (request.auth.uid == linkerUid
            || get(/databases/$(database)/documents/publishedRecipes/$(publishedId)).data.ownerUid == request.auth.uid);
      }
    }

    // Admin panel: collection-group READS for the platform-wide count()
    // aggregations. Overlapping matches OR together, so these only ADD the
    // admin's read access — every rule above keeps working unchanged.
    match /{path=**}/inventory/{paintId} {
      allow read: if isPlatformAdmin();
    }
    match /{path=**}/paintLists/{listId} {
      allow read: if isPlatformAdmin();
    }
    match /{path=**}/recipes/{recipeId} {
      allow read: if isPlatformAdmin();
    }
    match /{path=**}/linkedRecipes/{publishedId} {
      allow read: if isPlatformAdmin();
    }
    match /{path=**}/links/{linkerUid} {
      allow read: if isPlatformAdmin();
    }
  }
}
